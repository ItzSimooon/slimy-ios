<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A need button in the expanded slime notification: 56 dp tall, rounded. -->
    <style name="SlimeNotificationTile">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@drawable/slime_tile</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SlimeNotificationTileIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="SlimeNotificationTileBar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:max">100</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="SlimeNotificationTileLabel" parent="TextAppearance.Compat.Notification">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
